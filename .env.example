# Select the target explicitly: staging or production.
TARGET_ENV=staging
QA_ROLE=admin

MYCONDO_BASE_URL=https://replace-with-production-host
MYCONDO_STAGING_URL=https://mycondofe.kuningan.de

QA_TENANT_EMAIL=
QA_TENANT_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# German is the expected release language. Set to en for an English baseline.
MYCONDO_EXPECTED_LANGUAGE=de

# Keep final side effects disabled in automated runs.
MYCONDO_ALLOW_MUTATIONS=false

# Opt-in switches for special runs (not needed for the normal audits).
MYCONDO_CROSS_BROWSER=false
MYCONDO_RUN_GERMAN_E2E=false

# Optional comma-separated overrides/extensions.
MYCONDO_FORBIDDEN_ENGLISH_TERMS=
MYCONDO_PROTECTED_COPY=
MYCONDO_IGNORED_URL_PATTERNS=
MYCONDO_IGNORED_CONSOLE_PATTERNS=
